<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:CHROMA.ViewModels"
			 x:DataType="vm:CreateViewModel"
			 x:Class="CHROMA.Views.CreatePage"
			 Title="Create">

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="16">

			<!-- Section 1: Color Input + Input Mode (HEX or HSV) -->
			<Border Padding="12" StrokeThickness="1" Stroke="LightGray">
				<VerticalStackLayout Spacing="8">
					<Label Text="Select a Base Color"
							   FontAttributes="Bold"
							   FontSize="16"/>

						<!-- Input mode picker -->
					<HorizontalStackLayout Spacing="8">
						<Label Text="Mode:" VerticalOptions="Center" />
						<Picker ItemsSource="{Binding InputModes}"
								SelectedItem="{Binding SelectedInputMode}"
								WidthRequest="120" />
					</HorizontalStackLayout>
					
					<!-- HEX input block-->
					<VerticalStackLayout Spacing="4"
										 IsVisible="{Binding IsHexMode}">
						<Grid ColumnDefinitions="*,*"
							  ColumnSpacing="12">
							<VerticalStackLayout Grid.Column="0">
								<Label Text="Hex Input:" />
								<Label Text="HEX code format: #RRGGBB"
									   FontSize="11"
									   TextColor="Gray" />
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="1">
								<Entry Text="{Binding BaseHex}" />
							</VerticalStackLayout>
						</Grid>
					</VerticalStackLayout>
					
					<!-- HSV input block-->
					<VerticalStackLayout Spacing="4"
										 IsVisible="{Binding IsHSVMode}">
						<Label Text="HSV input" />
						<Grid ColumnDefinitions="*,*,*"
							  ColumnSpacing="8">
							<VerticalStackLayout Grid.Column="0">
								<Label Text="Hue (0–360°)" FontSize="11" />
								<Entry Text="{Binding HSV_Hue}"
									   Keyboard="Numeric"
									   Placeholder="30" />
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="1">
								<Label Text="Sat (0–100%)" FontSize="11" />
								<Entry Text="{Binding HSV_Saturation}"
									   Keyboard="Numeric"
									   Placeholder="70" />
							</VerticalStackLayout>
							<VerticalStackLayout Grid.Column="2">
								<Label Text="Val (0–100%)" FontSize="11" />
								<Entry Text="{Binding HSV_Value}"
									   Keyboard="Numeric"
									   Placeholder="90" />
							</VerticalStackLayout>
						</Grid>
					</VerticalStackLayout>

					<!-- Base color preview + status -->
					<HorizontalStackLayout Spacing="25"
										   Margin="200,8,0,0">
						<Button Text="Enter"
								Command="{Binding ApplyInputCommand}"
								HorizontalOptions="Start" />
						<Button Text="Reset"
								Command="{Binding ResetCommand}"
								HorizontalOptions="End" />
					</HorizontalStackLayout>
					<Label Text="Base Color Preview" FontAttributes="Bold" Margin="0,8,0,0" />
					<BoxView HeightRequest="40" Color="{Binding BaseColor}" />
					<Label Text="{Binding InputMessage}"
						   FontSize="11"
						   TextColor="DarkRed" />
				</VerticalStackLayout>
			</Border>

			<!-- Section 2: Harmony Selection & Swatch Results -->
			<Border Padding="12" StrokeThickness="1" Stroke="LightGray">
				<VerticalStackLayout Spacing="8">
					<Label Text="Harmony Scheme" FontAttributes="Bold"/>
					
					<Picker ItemsSource="{Binding Schemes}"
							SelectedItem="{Binding SelectedScheme}" />

					<Button Text="Generate Palette"
							Command="{Binding GenerateCommand}"
							Margin="0,8,0,0" />

					<Label Text="{Binding PaletteMessage}"
						   FontSize="11"
						   TextColor="DarkRed" />

					<!-- Swatch Display (Border + Grid Combo) -->
					<CollectionView ItemsSource="{Binding Palette}"
									Margin="0,12,0,0">
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="vm:ColorSlotViewModel">
								<Border Stroke="Lightgray"
										StrokeThickness="1"
										Padding="6"
										Margin="0,0,0,6">
									<Grid ColumnDefinitions="60,*"
										  ColumnSpacing="8">
										<BoxView Grid.Column="0"
												 HeightRequest="40"
												 VerticalOptions="Center"
												 Color="{Binding Color}" />
										<VerticalStackLayout Grid.Column="1"
															 Spacing="2">
											<Label Text="{Binding Label}" />
											<Label FontSize="11"
												   Text="{Binding Lightness, StringFormat='L: {0:F2}'}" />
										</VerticalStackLayout>
									</Grid>
								</Border>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</VerticalStackLayout>
			</Border>

			<!-- Section 3: Adjustable S & L for each Swatch (Hue is Locked in VM) -->
			<Border Padding="12" StrokeThickness="1" Stroke="LightGray">
				<VerticalStackLayout Spacing="8">
					<Label Text="Fine-tune Saturation + Lightness"
						   FontAttributes="Bold" />

					<CollectionView ItemsSource="{Binding Palette}">
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="vm:ColorSlotViewModel">
								<VerticalStackLayout Spacing="4" Margin="0,0,0,8">
									<Label Text="{Binding Label}" />
									<BoxView HeightRequest="24" Color="{Binding Color}" />
									<Label Text="Saturation" FontSize="11" />
									<Slider Minimum="0" Maximum="1"
											Value="{Binding Saturation}" />
									<Label Text="Lightness" FontSize="11" />
									<Slider Minimum="0" Maximum="1"
											Value="{Binding Lightness}" />
								</VerticalStackLayout>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>
				</VerticalStackLayout>
			</Border>

			<!-- Section 4: Visualization [placeholder for now] -->
			<Border Padding="12" StrokeThickness="1" Stroke="LightGray">
				<VerticalStackLayout Spacing="4">
					<Label Text="Visualization [preview]"
						   FontAttributes="Bold" />
					<BoxView HeightRequest="80"
							 Color="LightGray"
							 Opacity="0.3" />
					<Label Text="[MVP visualization of palette distribution will appear here.]"
						   FontSize="11"
						   TextColor="Gray" />
				</VerticalStackLayout>
			</Border>

			<!-- Section 5: Simple export block [placeholder for now] -->
			<Border Padding="12" StrokeThickness="1" Stroke="LightGray">
				<VerticalStackLayout Spacing="8">
					<Button Text="Export JSON" Command="{Binding ExportJsonCommand}" />
					<Editor Text="{Binding ExportJson}"
                            AutoSize="TextChanges"
                            IsReadOnly="True"
                            HeightRequest="120" />
				</VerticalStackLayout>
			</Border>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>