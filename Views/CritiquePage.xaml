<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:vm="clr-namespace:CHROMA.ViewModels"
			 xmlns:models="clr-namespace:CHROMA.Models"
			 x:DataType="vm:CritiqueViewModel"
             x:Class="CHROMA.Views.CritiquePage"
			 Title="Critique">

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="16">

			<!-- Section 1: Palette Input/Select -->
			<Border Padding="12">
				<VerticalStackLayout Spacing="8">
					<Label Text="Critique: Choose a Saved Palette"
						   TextColor="Black"
                           FontAttributes="Bold" />
					<Label Text="Pick a palette you created on the Create tab, then run the critique tests."
						   TextColor="Black"
                           FontSize="12" />
					
					<!-- Palette Selection -->
					<Picker Title="Select existing palette"
                            ItemsSource="{Binding SavedPalettes}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedPalette}" />
					
					<HorizontalStackLayout  Spacing="8">
						<Button Text="Refresh"
                                Command="{Binding LoadPalettesCommand}" />
						<Button Text="Run Critique"
                                Command="{Binding RunCritiqueCommand}" />
					</HorizontalStackLayout>
					<Label Text="{Binding StatusMessage}"
                       FontSize="12"
                       TextColor="Gray" />
				</VerticalStackLayout>
			</Border>

			<!-- Section 2: Feedback -->
			<Border Padding="12">
				<VerticalStackLayout Spacing="4">
					<Label Text="Critique Feedback"
                           FontAttributes="Bold" />

					<!-- Overall score + Per-rule results (spacing, contrast, similarity, balance) -->
					<Label Text="{Binding OverallScore, StringFormat='Overall score: {0}/100'}"
                           FontSize="14" />
					
					<CollectionView ItemsSource="{Binding RuleResults}"
									HeightRequest="180">
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="models:CritiqueRuleResult">
								<VerticalStackLayout Spacing="2" Margin="0,4,0,4">
									<!-- Rule name heading -->
									<Label Text="{Binding RuleName}"
                                           FontAttributes="Bold"
                                           FontSize="13" />

									<!-- Message + score row -->
									<Grid Padding="2">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="2*" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

										<!-- Short message -->
										<Label Text="{Binding Message}"
                                               Grid.Column="0" />

										<!-- Score -->
										<Label Text="{Binding Score, StringFormat='Score: {0}'}"
                                               Grid.Column="1"
                                               HorizontalTextAlignment="End" />
									</Grid>
								</VerticalStackLayout>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>

					<Label Text="{Binding History.Count, StringFormat='Previous critiques ({0})'}"
                           FontAttributes="Bold"
                           Margin="0,12,0,0" />

					<!-- Simple history: show palette name + summary -->
					<CollectionView ItemsSource="{Binding History}"
                                    HeightRequest="150">
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="models:CritiqueReport">
								<Grid Padding="4">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<!-- Palette name -->
									<Label Text="{Binding PaletteName}"
										   TextColor="Black"
                                           FontAttributes="Bold" />

									<!-- Short summary -->
									<Label Text="{Binding Summary}"
                                           FontSize="12"
                                           TextColor="#323232"
                                           Grid.Row="1" />
								</Grid>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>

				</VerticalStackLayout>
			</Border>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>