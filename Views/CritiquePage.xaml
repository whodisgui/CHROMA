<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
			 xmlns:vm="clr-namespace:CHROMA.ViewModels"
			 xmlns:models="clr-namespace:CHROMA.Models"
			 x:DataType="vm:CritiqueViewModel"
             x:Class="CHROMA.Views.CritiquePage"
			 Title="Critique">

	<ScrollView>
		<VerticalStackLayout Padding="16" Spacing="16">

            <Border Padding="12" StrokeThickness="1" Stroke="LightGray">
                <VerticalStackLayout Spacing="8">
                    <Label FontSize="18"
                           HorizontalTextAlignment="Center">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="In this current section of Chroma, you can receive a " />
                                <Span Text="critique"
                                      FontAttributes="Bold" />
                                <Span Text=" on the color palette(s) you have submitted by putting it through 4 tests on Spacing, Contrast, Similarity, and Balance.&#10;" />

                                <Span Text="&#10;This section is optional for you!"
                                      FontAttributes="Bold"/>
                                <Span Text="&#10;While art is ultimately subjective to those who view it and those who make it, " />
                                <Span Text="there is no exact right or wrong way to apply your colors and/or style." />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

                <!-- Section 1: Palette Input/Select -->
			<Border Padding="12">
				<VerticalStackLayout Spacing="8">
					<Label Text="Critique: Choose a Saved Palette"
						   TextColor="Black"
                           FontAttributes="Bold"
                           TextDecorations="Underline" />
					<Label Text="Pick a palette you created on the Create tab, then run the critique tests."
						   TextColor="Black" />
                    <Label Text="You may have to press &quot;Refresh&quot; for the palette to show up. Once selected, press &quot;Run Critique&quot;." />

                    <!-- Palette Selection -->
					<Picker Title="Select existing palette"
                            ItemsSource="{Binding SavedPalettes}"
                            ItemDisplayBinding="{Binding Name}"
                            SelectedItem="{Binding SelectedPalette}" />
					
					<HorizontalStackLayout  Spacing="8">
						<Button Text="Refresh"
                                Command="{Binding LoadPalettesCommand}" />
						<Button Text="Run Critique"
                                Command="{Binding RunCritiqueCommand}" />
					</HorizontalStackLayout>
					<Label Text="{Binding StatusMessage}"
                       FontSize="12"
                       TextColor="Gray" />
				</VerticalStackLayout>
			</Border>

            <Border Padding="12">
                <VerticalStackLayout Spacing="4">
                    <Label>
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="Upon running a critique on your selected palette, it will put it through 4 different tests:&#10;" />

                                <Span Text="&#10; 1) Harmony Spacing: " 
                                      FontAttributes="Bold"/>
                                <Span Text="Checks whether your palette’s hue positions match the expected spacing pattern of the chosen harmony scheme." />


                                <Span Text="&#10;&#10; 2) Contrast: " 
                                      FontAttributes="Bold"/>
                                <Span Text="Measures text/background readability by evaluating color-pair luminance contrast using WCAG rules (Web Content Accessibiliy Guidelines)." />

                                <Span Text="&#10;&#10; 3) Similarity: " 
                                      FontAttributes="Bold"/>
                                <Span Text="Detects whether any palette colors are too visually close or whether the set maintains clear, usable variety." />

                                <Span Text="&#10;&#10; 4) Balance: " 
                                      FontAttributes="Bold"/>
                                <Span Text="Evaluates how well the palette’s proportions follow a simple design hierarchy (like a 60/30/10 distribution)." />

                                <Span Text="&#10;&#10;Just to reiterate, despite these tests being made on some objective rules, they may or may not apply to your current artwork."
                                      FontAttributes="Bold"/>
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                </VerticalStackLayout>
            </Border>

			<!-- Section 2: Feedback -->
			<Border Padding="12">
				<VerticalStackLayout Spacing="4">
                    <Label Text="Critique Feedback:"
                           FontAttributes="Bold"
                           TextDecorations="Underline"
                           FontSize="18"/>

                    <!-- Overall score + Per-rule results (spacing, contrast, similarity, balance) -->
					<Label Text="{Binding OverallScore, StringFormat='Overall score: {0}/100'}"
                           FontSize="14" />
					
					<CollectionView ItemsSource="{Binding RuleResults}"
									HeightRequest="180">
						<CollectionView.ItemTemplate>
							<DataTemplate x:DataType="models:CritiqueRuleResult">
								<VerticalStackLayout Spacing="2" Margin="0,4,0,4">
									<!-- Rule name heading -->
									<Label Text="{Binding RuleName}"
                                           FontAttributes="Bold"
                                           FontSize="13" />

									<!-- Message + score row -->
									<Grid Padding="2">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="2*" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>

										<!-- Short message -->
										<Label Text="{Binding Message}"
                                               Grid.Column="0" />

										<!-- Score -->
										<Label Text="{Binding Score, StringFormat='Score: {0}'}"
                                               Grid.Column="1"
                                               HorizontalTextAlignment="End" />
									</Grid>
								</VerticalStackLayout>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>

					<Label Text="{Binding History.Count, StringFormat='Previous critiques ({0})'}"
                           FontAttributes="Bold"
                           Margin="0,12,0,0" />

					<!-- Simple history: show palette name + summary -->
                    <Label Text="This section shows a brief history of previous critique reports made.&#10;"
                           TextDecorations="Underline"
                           FontAttributes="Bold"/>
                    <CollectionView ItemsSource="{Binding History}"
                                    HeightRequest="150">

                        <CollectionView.ItemTemplate>
							<DataTemplate x:DataType="models:CritiqueReport">
								<Grid Padding="4">
									<Grid.RowDefinitions>
										<RowDefinition Height="Auto" />
										<RowDefinition Height="Auto" />
									</Grid.RowDefinitions>

									<!-- Palette name -->
									<Label Text="{Binding PaletteName}"
										   TextColor="Black"
                                           FontAttributes="Bold" />

									<!-- Short summary -->
									<Label Text="{Binding Summary}"
                                           FontSize="12"
                                           TextColor="#323232"
                                           Grid.Row="1" />
								</Grid>
							</DataTemplate>
						</CollectionView.ItemTemplate>
					</CollectionView>

				</VerticalStackLayout>
			</Border>

		</VerticalStackLayout>
	</ScrollView>
</ContentPage>